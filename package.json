{
  "name": "iconify",
  "type": "module",
  "version": "1.0.17",
  "description": "⚡ High-performance icon set generator. Generate favicons, PWA icons, iOS, and Android assets in seconds.",
  "author": "Maximiliano Garcia Mortigliengo",
  "license": "ISC",
  "homepage": "https://github.com/MaxiGarcia13/iconify#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxiGarcia13/iconify.git"
  },
  "bugs": {
    "url": "https://github.com/MaxiGarcia13/iconify/issues"
  },
  "keywords": [
    "favicon",
    "favicon generator",
    "icon generator",
    "icon set generator",
    "icon set",
    "pwa icons",
    "ios icons",
    "android icons",
    "apple touch icon",
    "og image",
    "web icons"
  ],
  "scripts": {
    "prepare": "simple-git-hooks",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "clean": "rm -rf dist node_modules .astro",
    "phoenix": "npm run clean && rm package-lock.json && npm i",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@astrojs/vercel": "^11.0.11",
    "@imgly/background-removal": "^1.7.0",
    "@maxigarcia/js-utils": "^1.15.0",
    "archiver": "^7.0.1",
    "astro": "^7.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.3",
    "to-ico": "^1.1.5"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.20.8",
    "@maxigarcia/eslint-config": "^1.14.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/archiver": "^7.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/to-ico": "^1.1.3",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "lint-staged": "^17.5.1",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,astro}": "npm run lint:fix"
  }
}
